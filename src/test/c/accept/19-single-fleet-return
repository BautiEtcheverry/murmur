// `all` is modelled as an implicit fleet-ref, so a single-fleet return is
// just as valid as `all return to Base before ...`.
drone Scout { endurance 25 [min]; max_speed 18 [m/s]; }
fleet Alpha = 2 of Scout;
station Base = point (0, 0) altitude 0 [m];
mission SingleReturn window 0 [s] .. 400 [s] {
  Alpha takeoff from Base at 0 [s];
  Alpha return to Base before 380 [s];
}

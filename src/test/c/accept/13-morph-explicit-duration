// Spec test (XIII): formation morph with an explicit duration.
drone Scout { endurance 25 [min]; max_speed 18 [m/s]; }
fleet Alpha = 4 of Scout;
station Base = point (0, 0) altitude 0 [m];
formation Peine = line spacing 30 [m];
mission MorphOnly window 0 [s] .. 200 [s] {
  Alpha takeoff from Base at 0 [s];
  Alpha morph to Peine over 25 [s];
  Alpha land at Base at 180 [s];
}

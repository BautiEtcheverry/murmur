// A fleet must take off before executing any other maneuver.
drone Scout { endurance 25 [min]; max_speed 18 [m/s]; }
fleet Alpha = 2 of Scout;
station Base = point (0, 0) altitude 0 [m];
mission Grounded window 0 [s] .. 300 [s] {
  Alpha hold for 30 [s];
  Alpha takeoff from Base at 60 [s];
  Alpha land at Base at 280 [s];
}

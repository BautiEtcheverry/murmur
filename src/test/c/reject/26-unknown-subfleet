// The fleet Alpha has no aircraft of type Thermal.
drone Scout   { endurance 25 [min]; max_speed 18 [m/s]; }
drone Thermal { endurance 40 [min]; max_speed 12 [m/s]; }
fleet Alpha = 2 of Scout;
station Base = point (0, 0) altitude 0 [m];
mission Missing window 0 [s] .. 300 [s] {
  Alpha takeoff from Base at 0 [s];
  Alpha.Thermal hold for 10 [s];
  Alpha land at Base at 280 [s];
}

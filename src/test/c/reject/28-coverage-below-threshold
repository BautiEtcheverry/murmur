// A single pass at low altitude cannot observe 95 [%] of a large zone.
drone Scout {
  endurance 25 [min];
  max_speed 18 [m/s];
  payload rgb_camera resolution 4000 [px] fov 30 [deg];
}
fleet Alpha = 1 of Scout;
station Base = point (0, 0) altitude 0 [m];
zone AOI = polygon [(0,0), (400,0), (400,400), (0,400)];
mission Sparse window 0 [s] .. 900 [s] {
  Alpha takeoff from Base at 0 [s];
  Alpha sweep AOI with lawnmower spacing 200 [m] altitude 20 [m];
  Alpha land at Base at 880 [s];
  constraints {
    require coverage of AOI >= 95 [%];
  }
}

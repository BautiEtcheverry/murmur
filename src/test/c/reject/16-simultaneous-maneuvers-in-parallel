// Spec reject (XI): the same sub-fleet commanded twice inside a parallel block.
drone Scout   { endurance 25 [min]; max_speed 18 [m/s]; }
drone Thermal { endurance 40 [min]; max_speed 12 [m/s]; }
fleet Bravo = 3 of Scout + 2 of Thermal;
station Base = point (0, 0) altitude 0 [m];
mission Clash window 0 [s] .. 300 [s] {
  Bravo takeoff from Base at 0 [s];
  parallel {
    Bravo.Scout hold for 30 [s];
    Bravo.Scout morph to line spacing 20 [m] over 30 [s];
  }
  Bravo land at Base at 280 [s];
}

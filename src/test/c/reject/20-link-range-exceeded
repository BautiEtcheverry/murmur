// Spec reject (XV): the orbit is 2 [km] away, but the link only reaches 500 [m].
drone Relay { endurance 40 [min]; max_speed 15 [m/s]; link_range 500 [m]; }
fleet Alpha = 1 of Relay;
station Base = point (0, 0) altitude 0 [m];
zone Far = circle at (2000, 0) radius 20 [m];
mission TooFar window 0 [s] .. 900 [s] {
  Alpha takeoff from Base at 0 [s];
  Alpha orbit Far radius 50 [m] altitude 60 [m] for 60 [s];
  Alpha return to Base before 880 [s];
}
